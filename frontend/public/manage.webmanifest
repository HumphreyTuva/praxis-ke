{
  "name": "Praxis KE Admin",
  "short_name": "PK Admin",
  "description": "Manage the Praxis KE website: messages, publications and research areas.",
  "id": "/manage",
  "start_url": "/manage",
  "scope": "/manage",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAF8EF",
  "theme_color": "#0B3325",
  "icons": [
    { "src": "/favicons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/favicons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/favicons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/manage/messages" },
    { "name": "New publication", "url": "/manage/publications/new" }
  ]
}
